generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  RISK_OPS
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum MarketStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  RESOLVED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL_HOLD
  WITHDRAWAL_RELEASE
  WITHDRAWAL
  TRADE
  FEE
  SETTLEMENT
  ADJUSTMENT
}

enum AssetClass {
  NATIVE
  TOKEN
}

enum NetworkFamily {
  BITCOIN
  EVM
  SOLANA
  XRPL
}

enum NetworkEnvironment {
  SANDBOX
  PRODUCTION
}

enum WalletAddressRole {
  DEPOSIT_POOL
  HOT_WITHDRAWAL
  COLD_RESERVE
  FEE_PAYER
}

enum WalletAddressStatus {
  AVAILABLE
  ASSIGNED
  INACTIVE
  RETIRED
}

enum AddressAssignmentStatus {
  ACTIVE
  REVOKED
}

enum DepositStatus {
  PENDING
  CONFIRMED
  CREDITED
  FAILED
}

enum WithdrawalStatus {
  REQUESTED
  VALIDATED
  RISK_REVIEW
  APPROVED
  PENDING_MANUAL_BROADCAST
  BROADCASTING
  BROADCAST
  CONFIRMING
  CONFIRMED
  CREDITED
  REJECTED
  FAILED
}

enum WithdrawalExecutorType {
  MANUAL_BROADCAST
  PRODUCTION_CUSTODY
}

enum ReconciliationStatus {
  OK
  DISCREPANCY_FOUND
  ERROR
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

// ────────────────────────────────────────────────────────────────────────
// Identity
// ────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(PENDING_VERIFICATION)
  totpSecret   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens              RefreshToken[]
  orders                     Order[]
  positions                  Position[]
  ledgerAccounts             LedgerAccount[]
  depositAddressAssignments  DepositAddressAssignment[]
  deposits                   Deposit[]
  withdrawals                Withdrawal[]
  riskLimit                  RiskLimit?
  createdMarkets             Market[]                    @relation("MarketCreatedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ────────────────────────────────────────────────────────────────────────
// Markets & Trading
// ────────────────────────────────────────────────────────────────────────

model MarketCategory {
  id   String @id @default(uuid())
  slug String @unique
  name String

  markets Market[]

  @@map("market_categories")
}

model Market {
  id               String       @id @default(uuid())
  slug             String       @unique
  title            String
  description      String
  categoryId       String
  status           MarketStatus @default(DRAFT)
  closeTime        DateTime?
  resolutionSource String?
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  category    MarketCategory  @relation(fields: [categoryId], references: [id])
  createdBy   User            @relation("MarketCreatedBy", fields: [createdById], references: [id])
  outcomes    MarketOutcome[]
  orders      Order[]
  settlements Settlement[]

  @@index([categoryId])
  @@map("markets")
}

model MarketOutcome {
  id        String   @id @default(uuid())
  marketId  String
  label     String
  createdAt DateTime @default(now())

  market      Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  orders      Order[]
  positions   Position[]
  settlements Settlement[]

  @@unique([marketId, label])
  @@map("market_outcomes")
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  marketId        String
  outcomeId       String
  side            OrderSide
  type            OrderType
  price           Decimal?    @db.Decimal(18, 6)
  quantity        Decimal     @db.Decimal(36, 18)
  filledQuantity  Decimal     @default(0) @db.Decimal(36, 18)
  status          OrderStatus @default(OPEN)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  market    Market        @relation(fields: [marketId], references: [id])
  outcome   MarketOutcome @relation(fields: [outcomeId], references: [id])
  makerFills Fill[] @relation("MakerOrder")
  takerFills Fill[] @relation("TakerOrder")

  @@index([marketId, outcomeId, status])
  @@index([userId])
  @@map("orders")
}

model Fill {
  id            String   @id @default(uuid())
  makerOrderId  String
  takerOrderId  String
  marketId      String
  outcomeId     String
  price         Decimal  @db.Decimal(18, 6)
  quantity      Decimal  @db.Decimal(36, 18)
  fee           Decimal  @default(0) @db.Decimal(36, 18)
  createdAt     DateTime @default(now())

  makerOrder Order @relation("MakerOrder", fields: [makerOrderId], references: [id])
  takerOrder Order @relation("TakerOrder", fields: [takerOrderId], references: [id])

  @@index([marketId, outcomeId])
  @@map("fills")
}

model Position {
  id          String   @id @default(uuid())
  userId      String
  marketId    String
  outcomeId   String
  quantity    Decimal  @default(0) @db.Decimal(36, 18)
  avgPrice    Decimal  @default(0) @db.Decimal(18, 6)
  realizedPnl Decimal  @default(0) @db.Decimal(36, 18)
  updatedAt   DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  outcome MarketOutcome @relation(fields: [outcomeId], references: [id])

  @@unique([userId, marketId, outcomeId])
  @@map("positions")
}

model Settlement {
  id             String   @id @default(uuid())
  marketId       String
  outcomeId      String
  payoutPerShare Decimal  @db.Decimal(18, 6)
  status         String   @default("PENDING")
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  market  Market        @relation(fields: [marketId], references: [id])
  outcome MarketOutcome @relation(fields: [outcomeId], references: [id])

  @@index([marketId])
  @@map("settlements")
}

// ────────────────────────────────────────────────────────────────────────
// Ledger (authoritative accounting — append-only entries)
// ────────────────────────────────────────────────────────────────────────

model LedgerAccount {
  id            String   @id @default(uuid())
  userId        String
  assetId       String
  cachedBalance Decimal  @default(0) @db.Decimal(36, 18)
  updatedAt     DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  asset   Asset         @relation(fields: [assetId], references: [id])
  entries LedgerEntry[]

  @@unique([userId, assetId])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id            String          @id @default(uuid())
  accountId     String
  amount        Decimal         @db.Decimal(36, 18)
  type          LedgerEntryType
  referenceType String
  referenceId   String
  balanceAfter  Decimal         @db.Decimal(36, 18)
  createdAt     DateTime        @default(now())

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

// ────────────────────────────────────────────────────────────────────────
// Asset / Network model
// ────────────────────────────────────────────────────────────────────────

model Asset {
  id                   String     @id @default(uuid())
  symbol               String     @unique
  name                 String
  decimals             Int
  assetClass           AssetClass
  isSettlementCurrency Boolean    @default(false)
  isActive             Boolean    @default(true)

  assetNetworks              AssetNetwork[]
  ledgerAccounts              LedgerAccount[]
  depositAddressAssignments  DepositAddressAssignment[]
  deposits                    Deposit[]

  @@map("assets")
}

model Network {
  id          String             @id @default(uuid())
  code        String             @unique
  family      NetworkFamily
  environment NetworkEnvironment
  name        String
  isActive    Boolean            @default(true)

  assetNetworks             AssetNetwork[]
  depositAddressAssignments DepositAddressAssignment[]

  @@map("networks")
}

model AssetNetwork {
  id                  String   @id @default(uuid())
  assetId             String
  networkId           String
  isNative            Boolean  @default(false)
  contractAddress     String?
  memoRequired         Boolean  @default(false)
  minConfirmations     Int      @default(1)
  depositMinAmount     Decimal  @default(0) @db.Decimal(36, 18)
  withdrawalMinAmount  Decimal  @default(0) @db.Decimal(36, 18)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  asset   Asset   @relation(fields: [assetId], references: [id])
  network Network @relation(fields: [networkId], references: [id])

  walletAddresses            WalletAddress[]
  deposits                   Deposit[]
  withdrawals                Withdrawal[]
  executionConfig            WithdrawalExecutionConfig?
  watchCursor                BlockchainWatchCursor?
  reconciliationRuns         ReconciliationRun[]

  @@unique([assetId, networkId])
  @@map("asset_networks")
}

// ────────────────────────────────────────────────────────────────────────
// Wallet addresses & deposit-address assignment (one dedicated address
// per user + asset + network — pre-provisioned pool, no per-tx generation)
// ────────────────────────────────────────────────────────────────────────

model WalletAddress {
  id              String              @id @default(uuid())
  assetNetworkId  String
  address         String
  destinationTag  String?
  role            WalletAddressRole   @default(DEPOSIT_POOL)
  environment     NetworkEnvironment
  status          WalletAddressStatus @default(AVAILABLE)
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id])
  assignment   DepositAddressAssignment?
  deposits     Deposit[]
  withdrawalsAsSource Withdrawal[]

  @@unique([assetNetworkId, address])
  @@index([assetNetworkId, role, status])
  @@map("wallet_addresses")
}

model DepositAddressAssignment {
  id              String                  @id @default(uuid())
  userId          String
  assetId         String
  networkId       String
  assetNetworkId  String
  walletAddressId String                  @unique
  destinationTag  String?
  environment     NetworkEnvironment
  status          AddressAssignmentStatus @default(ACTIVE)
  assignedAt      DateTime                @default(now())
  metadata        Json?

  user          User          @relation(fields: [userId], references: [id])
  asset         Asset         @relation(fields: [assetId], references: [id])
  network       Network       @relation(fields: [networkId], references: [id])
  walletAddress WalletAddress @relation(fields: [walletAddressId], references: [id])

  @@unique([userId, assetId, networkId])
  @@map("deposit_address_assignments")
}

// ────────────────────────────────────────────────────────────────────────
// Deposits & Withdrawals
// ────────────────────────────────────────────────────────────────────────

model Deposit {
  id                    String        @id @default(uuid())
  userId                String
  assetId               String
  assetNetworkId        String
  walletAddressId       String
  txHash                String
  amount                Decimal       @db.Decimal(36, 18)
  confirmations         Int           @default(0)
  requiredConfirmations Int
  status                DepositStatus @default(PENDING)
  rawProviderPayload    Json?
  detectedAt            DateTime      @default(now())
  confirmedAt           DateTime?
  creditedAt            DateTime?

  user          User         @relation(fields: [userId], references: [id])
  asset         Asset        @relation(fields: [assetId], references: [id])
  assetNetwork  AssetNetwork @relation(fields: [assetNetworkId], references: [id])
  walletAddress WalletAddress @relation(fields: [walletAddressId], references: [id])

  @@unique([assetNetworkId, txHash])
  @@index([userId, status])
  @@map("deposits")
}

model Withdrawal {
  id                  String           @id @default(uuid())
  userId              String
  assetNetworkId      String
  sourceWalletAddressId String?
  destinationAddress  String
  destinationTag      String?
  amount              Decimal          @db.Decimal(36, 18)
  fee                 Decimal          @default(0) @db.Decimal(36, 18)
  status              WithdrawalStatus @default(REQUESTED)
  txHash              String?
  broadcastByAdminId  String?
  broadcastAt         DateTime?
  confirmedAt         DateTime?
  failureReason       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user             User          @relation(fields: [userId], references: [id])
  assetNetwork     AssetNetwork  @relation(fields: [assetNetworkId], references: [id])
  sourceWalletAddress WalletAddress? @relation(fields: [sourceWalletAddressId], references: [id])

  @@index([userId, status])
  @@index([assetNetworkId, status])
  @@map("withdrawals")
}

model WithdrawalExecutionConfig {
  id             String                 @id @default(uuid())
  assetNetworkId String                 @unique
  environment    NetworkEnvironment
  executorType   WithdrawalExecutorType @default(MANUAL_BROADCAST)
  providerRef    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id])

  @@map("withdrawal_execution_configs")
}

// ────────────────────────────────────────────────────────────────────────
// Monitoring / reconciliation
// ────────────────────────────────────────────────────────────────────────

model BlockchainWatchCursor {
  id                 String   @id @default(uuid())
  assetNetworkId     String   @unique
  lastScannedPointer String
  updatedAt          DateTime @updatedAt

  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id])

  @@map("blockchain_watch_cursors")
}

model ReconciliationRun {
  id             String               @id @default(uuid())
  assetNetworkId String
  runAt          DateTime             @default(now())
  status         ReconciliationStatus
  discrepancies  Json?
  notes          String?

  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id])

  @@index([assetNetworkId, runAt])
  @@map("reconciliation_runs")
}

// ────────────────────────────────────────────────────────────────────────
// Risk & Audit
// ────────────────────────────────────────────────────────────────────────

model RiskLimit {
  id                 String   @id @default(uuid())
  userId             String   @unique
  maxPositionSize    Decimal? @db.Decimal(36, 18)
  maxDailyWithdrawal Decimal? @db.Decimal(36, 18)
  kycTier            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("risk_limits")
}

model AuditLog {
  id           String         @id @default(uuid())
  actorId      String?
  actorType    AuditActorType
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  ip           String?
  createdAt    DateTime       @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
