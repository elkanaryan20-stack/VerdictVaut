generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  RISK_OPS
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

// DRAFT -> OPEN -> CLOSED -> RESOLVING -> RESOLVED, with CANCELLED reachable
// from any pre-RESOLVED state and PAUSED a reversible halt from OPEN back to
// OPEN. Trading is allowed only in OPEN (enforced in OrdersService, not by a
// CHECK constraint, since that decision needs application context).
enum MarketStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  RESOLVING
  RESOLVED
  CANCELLED
}

enum OrderSide {
  BUY
  SELL
}

// MARKET exists as a value for forward compatibility but is rejected at the
// service layer for now — see OrdersService. A resting "market order" with
// no matching engine to execute it immediately is an incoherent state, not
// a safe simplification.
enum OrderType {
  LIMIT
  MARKET
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
  REJECTED
}

enum LedgerTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  FEE
  SETTLEMENT
  ADJUSTMENT
  REVERSAL
}

enum LedgerAccountOwnerType {
  USER
  HOUSE
}

// House/omnibus counterparties. EXTERNAL_CHAIN is the mirror of the outside
// blockchain world — it is credited/debited opposite every deposit and
// withdrawal so those transactions balance, and it is explicitly exempt
// from the non-negative-balance rule (see the DB CHECK constraint): its
// balance is a running net-inflow figure, not real platform funds.
enum HouseAccountKey {
  EXTERNAL_CHAIN
  FEE_REVENUE
  // Counterparty for market-resolution payouts (see SettlementService).
  // DELIBERATE ACCOUNTING BOUNDARY: this system has no complete-set /
  // collateral-minting mechanism for outcome shares — a share's cash
  // counterpart is never escrowed at trade time (a BUY's reserved cash
  // is simply transferred to the matched SELL's own cash balance at
  // execution, per ExecutionCoordinator.postTradeLedger; nothing is set
  // aside against future settlement). So a winning position's payout at
  // resolution is not backed by pre-collateralized platform funds — this
  // account funds it directly and is expected to run persistently
  // negative, exactly like EXTERNAL_CHAIN. Losing positions receive a
  // zero payout and post no ledger entry at all, so nothing ever flows
  // the other way to offset this. Replacing this with real
  // collateralization (e.g. locking BUY-side cash into this pool at
  // trade time, or a complete-set mint/split mechanism) is out of scope
  // for this phase and should happen before real funds are on the line.
  SETTLEMENT_POOL
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CAPTURED
}

enum AssetClass {
  NATIVE
  TOKEN
}

enum NetworkFamily {
  BITCOIN
  EVM
  SOLANA
  XRPL
}

enum NetworkEnvironment {
  SANDBOX
  PRODUCTION
}

enum WalletAddressRole {
  DEPOSIT_POOL
  HOT_WITHDRAWAL
  COLD_RESERVE
  FEE_PAYER
}

enum WalletAddressStatus {
  AVAILABLE
  ASSIGNED
  INACTIVE
  RETIRED
}

enum AddressAssignmentStatus {
  ACTIVE
  REVOKED
}

enum DepositStatus {
  PENDING
  CONFIRMED
  CREDITED
  FAILED
}

enum WithdrawalStatus {
  REQUESTED
  VALIDATED
  RISK_REVIEW
  APPROVED
  PENDING_MANUAL_BROADCAST
  BROADCASTING
  BROADCAST
  CONFIRMING
  CONFIRMED
  CREDITED
  REJECTED
  FAILED
}

enum WithdrawalExecutorType {
  MANUAL_BROADCAST
  PRODUCTION_CUSTODY
}

enum ReconciliationStatus {
  OK
  DISCREPANCY_FOUND
  ERROR
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

// PENDING never actually persists today — Settlement rows are created
// already-COMPLETED at resolution time (the payout RATE for an outcome is
// decided and fixed the instant the market resolves; nothing further
// "processes" about it afterward). Kept as a real state, not collapsed to
// a boolean, so a future multi-step rate-approval workflow has somewhere
// to live without a schema change.
enum SettlementStatus {
  PENDING
  COMPLETED
}

// ────────────────────────────────────────────────────────────────────────
// Identity
// ────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(PENDING_VERIFICATION)
  totpSecret   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens             RefreshToken[]
  orders                    Order[]
  positions                 Position[]
  ledgerAccounts            LedgerAccount[]
  depositAddressAssignments DepositAddressAssignment[]
  deposits                  Deposit[]
  withdrawals               Withdrawal[]
  riskLimit                 RiskLimit?
  createdMarkets            Market[]                   @relation("MarketCreatedBy")
  fillsAsBuyer              Fill[]                     @relation("FillBuyer")
  fillsAsSeller             Fill[]                     @relation("FillSeller")
  marketResolutions         MarketResolution[]
  positionSettlements       PositionSettlement[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ────────────────────────────────────────────────────────────────────────
// Markets & Trading
// ────────────────────────────────────────────────────────────────────────

model MarketCategory {
  id   String @id @default(uuid())
  slug String @unique
  name String

  markets Market[]

  @@map("market_categories")
}

model Market {
  id                 String       @id @default(uuid())
  slug               String       @unique
  title              String
  description        String
  categoryId         String
  status             MarketStatus @default(DRAFT)
  resolutionSource   String?
  // What resolves the market, as distinct from resolutionSource (where to
  // check) — the rule a resolver applies, e.g. "Resolves YES if the Fed
  // cuts rates at the March 2027 FOMC meeting per the official statement."
  resolutionCriteria String?
  openTime           DateTime?
  closeTime          DateTime?
  resolutionTime     DateTime?
  // Optional per-market cap on aggregate open BUY exposure (sum of
  // remainingQuantity * price across resting BUY orders) for one outcome.
  // Null means no cap is configured — never a silently-invented default.
  maxExposure        Decimal?     @db.Decimal(36, 18)
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  category    MarketCategory  @relation(fields: [categoryId], references: [id])
  createdBy   User            @relation("MarketCreatedBy", fields: [createdById], references: [id])
  outcomes    MarketOutcome[]
  orders      Order[]
  settlements Settlement[]
  resolution  MarketResolution?
  positionSettlements PositionSettlement[]

  @@index([categoryId])
  @@index([status])
  @@map("markets")
}

model MarketOutcome {
  id        String   @id @default(uuid())
  marketId  String
  // Stable, machine-referenced identifier (e.g. "YES"/"NO") — distinct from
  // `label`, the human-readable display text, so relabeling a market never
  // touches the identity outcomes are ordered/traded by. Binary markets use
  // YES/NO today; the model does not assume only two outcomes ever exist.
  key       String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  market      Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  orders      Order[]
  positions   Position[]
  settlements Settlement[]
  resolutionWins      MarketResolution[]
  positionSettlements PositionSettlement[]

  @@unique([marketId, key])
  @@map("market_outcomes")
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  marketId          String
  outcomeId         String
  side              OrderSide
  type              OrderType
  price             Decimal?    @db.Decimal(18, 6)
  quantity          Decimal     @db.Decimal(36, 18)
  filledQuantity    Decimal     @default(0) @db.Decimal(36, 18)
  // The live field the (future) matcher decrements; filledQuantity is the
  // complementary historical figure. filledQuantity + remainingQuantity =
  // quantity is enforced by a DB CHECK constraint, not just convention.
  remainingQuantity Decimal     @db.Decimal(36, 18)
  status            OrderStatus @default(OPEN)
  // Client-supplied (or server-generated when omitted) idempotency key.
  // Always populated — see OrdersService — so the unique index below is
  // never defeated by NULLs not colliding under Postgres's default
  // unique-index semantics.
  clientOrderId     String
  // Monotonic, gap-tolerant, server-assigned tie-breaker for price-time
  // priority. createdAt is a millisecond timestamp — two orders placed in
  // the same millisecond (routine under concurrent submission) would be
  // ordered ambiguously by it, and the id (a UUID) is intentionally
  // non-sequential and must never be used as an ordering signal. sequence
  // is a DB-generated bigserial: strictly increasing, assigned atomically
  // at insert time, safe as the deterministic same-price FIFO tie-breaker
  // the matching engine relies on.
  sequence          BigInt      @unique @default(autoincrement())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  market    Market        @relation(fields: [marketId], references: [id])
  outcome   MarketOutcome @relation(fields: [outcomeId], references: [id])
  buyFills  Fill[]        @relation("BuyOrder")
  sellFills Fill[]        @relation("SellOrder")
  makerFills Fill[]       @relation("MakerOrder")
  takerFills Fill[]       @relation("TakerOrder")

  @@unique([userId, clientOrderId])
  // Primary order-book / price-time-priority lookup path: resting
  // candidates for a given market+outcome+side+status, ordered by price
  // then by the deterministic sequence tie-breaker.
  @@index([marketId, outcomeId, side, status, price, sequence])
  @@index([marketId, outcomeId, status])
  @@index([userId])
  @@map("orders")
}

model Fill {
  id             String   @id @default(uuid())
  marketId       String
  outcomeId      String
  buyOrderId     String
  sellOrderId    String
  // MAKER = the resting order that was already on the book (its price is
  // always the execution price). TAKER = the incoming order that crossed
  // it. Always one of makerOrderId/takerOrderId equals buyOrderId and the
  // other equals sellOrderId — enforced by fills_maker_taker_check — but
  // buy/sell (economic direction) and maker/taker (who was resting vs.
  // incoming) are independent axes and both are kept explicit rather than
  // derived, since either one could be the maker.
  makerOrderId   String
  takerOrderId   String
  buyerUserId    String
  sellerUserId   String
  price          Decimal  @db.Decimal(18, 6)
  quantity       Decimal  @db.Decimal(36, 18)
  fee            Decimal  @default(0) @db.Decimal(36, 18)
  // Deterministic, derived from the (makerOrderId, takerOrderId) execution
  // identity by the matching/execution layer — guards against the same
  // match being applied twice (retry, concurrent re-derivation of the same
  // instruction), the same primitive used for LedgerTransaction/
  // FundReservation in the ledger. Fills are append-only: no service
  // method updates an existing Fill row.
  idempotencyKey String   @unique
  executedAt     DateTime @default(now())

  buyOrder  Order @relation("BuyOrder", fields: [buyOrderId], references: [id])
  sellOrder Order @relation("SellOrder", fields: [sellOrderId], references: [id])
  makerOrder Order @relation("MakerOrder", fields: [makerOrderId], references: [id])
  takerOrder Order @relation("TakerOrder", fields: [takerOrderId], references: [id])
  buyer     User  @relation("FillBuyer", fields: [buyerUserId], references: [id])
  seller    User  @relation("FillSeller", fields: [sellerUserId], references: [id])

  @@index([marketId, outcomeId])
  @@index([buyOrderId])
  @@index([sellOrderId])
  @@index([makerOrderId])
  @@index([takerOrderId])
  @@map("fills")
}

model Position {
  id               String   @id @default(uuid())
  userId           String
  marketId         String
  outcomeId        String
  quantity         Decimal  @default(0) @db.Decimal(36, 18)
  // Earmarked by an ACTIVE PositionReservation (SELL orders) — the
  // outcome-share mirror of LedgerAccount.reservedBalance. Available shares
  // = quantity - reservedQuantity, enforced by DB CHECK, same invariant
  // shape as the cash ledger's.
  reservedQuantity Decimal  @default(0) @db.Decimal(36, 18)
  avgPrice         Decimal  @default(0) @db.Decimal(18, 6)
  // Ordinary trade P&L, realized the instant shares change hands (see
  // ExecutionCoordinator.updatePositions) — entirely independent of, and
  // NOT the same figure as, a market-resolution settlement payout (see
  // PositionSettlement.payoutAmount). Never conflate the two.
  realizedPnl      Decimal  @default(0) @db.Decimal(36, 18)
  // Null = not yet settled. Set exactly once, atomically with the
  // creation of this position's PositionSettlement row (which is the
  // actual idempotent guarantee — see that model). A frozen historical
  // marker: nothing updates quantity/avgPrice/realizedPnl after this is
  // set, since no further trading can occur once a market leaves OPEN.
  settledAt        DateTime?
  updatedAt        DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id])
  outcome      MarketOutcome         @relation(fields: [outcomeId], references: [id])
  reservations PositionReservation[]
  settlement   PositionSettlement?

  @@unique([userId, marketId, outcomeId])
  // Enumerating a market's still-unsettled positions (SettlementService)
  // is an indexed range scan, not a full-table scan.
  @@index([marketId, settledAt])
  @@map("positions")
}

// Outcome-share reservation — the position-quantity counterpart to
// FundReservation (cash). Deliberately mirrors its shape (ACTIVE ->
// RELEASED|CAPTURED, its own idempotency key) rather than reusing
// FundReservation directly, because FundReservation is hard-FK'd to
// LedgerAccount (a real-asset account) and shares are not a LedgerAccount
// asset — conflating the two would be the "accounting shortcut" this
// architecture is explicitly trying to avoid.
model PositionReservation {
  id             String            @id @default(uuid())
  positionId     String
  amount         Decimal           @db.Decimal(36, 18)
  // Portion of `amount` already applied against a real execution (a SELL
  // fill). A partial fill consumes only the executed quantity, leaving the
  // remainder ACTIVE and earmarked for the rest of the order — release()
  // and capture() must net against this, never against the full original
  // `amount`, or a partially-consumed reservation would be double-counted
  // on release. 0 <= consumedAmount <= amount, enforced by a DB CHECK.
  consumedAmount Decimal           @default(0) @db.Decimal(36, 18)
  status         ReservationStatus @default(ACTIVE)
  referenceType  String
  referenceId    String
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  releasedAt     DateTime?
  capturedAt     DateTime?

  position Position @relation(fields: [positionId], references: [id])

  @@index([positionId, status])
  @@index([referenceType, referenceId])
  @@map("position_reservations")
}

// The resolved payout RATE for one outcome of one market — exactly one
// row per (market, outcome), created for EVERY outcome (not just the
// winner) atomically with MarketResolution, in the same transaction as
// the CLOSED -> RESOLVING status transition. This is the rate; it says
// nothing about any individual user's position — that is
// PositionSettlement's job, one level down.
model Settlement {
  id             String           @id @default(uuid())
  marketId       String
  outcomeId      String
  payoutPerShare Decimal          @db.Decimal(18, 6)
  status         SettlementStatus @default(PENDING)
  processedAt    DateTime?
  createdAt      DateTime         @default(now())

  market  Market        @relation(fields: [marketId], references: [id])
  outcome MarketOutcome @relation(fields: [outcomeId], references: [id])

  @@unique([marketId, outcomeId])
  @@map("settlements")
}

// The single authoritative, auditable record of what a market resolved
// to — created exactly once per market (marketId is unique, the actual
// DB-level "never resolve twice" guarantee, alongside the CLOSED ->
// RESOLVING CAS in ResolutionService) atomically with that transition.
// resolvedAt is when the outcome was DECIDED; settledAt is a distinct,
// later event — set only once every position in this market has been
// paid out and the market reaches RESOLVED (see SettlementService). A
// market can sit with resolvedAt set and settledAt still null for a
// while if settlement is large/retried; that is an expected, valid,
// in-progress state (status = RESOLVING), not a bug.
model MarketResolution {
  id               String    @id @default(uuid())
  marketId         String    @unique
  winningOutcomeId String
  resolverId       String
  // Optional human-readable rationale (e.g. a citation of the resolution
  // source). Free text, not JSON — there is nothing structured to gain
  // from encoding a rationale as a document.
  notes            String?
  resolvedAt       DateTime  @default(now())
  settledAt        DateTime?

  market         Market        @relation(fields: [marketId], references: [id])
  winningOutcome MarketOutcome @relation(fields: [winningOutcomeId], references: [id])
  resolver       User          @relation(fields: [resolverId], references: [id])

  @@map("market_resolutions")
}

// Append-only, idempotent, per-position payout record — the settlement
// counterpart to Fill. Its existence (idempotencyKey unique, positionId
// unique) IS the authoritative "this position has been settled"
// guarantee: it is created in the SAME transaction as the ledger posting
// (when payoutAmount > 0) and the owning Position's settledAt stamp, so
// this row existing implies both already happened too — never partially.
// quantity/payoutPerShare are immutable snapshots taken at settlement
// time, independent of Position's own (by then frozen) figures.
model PositionSettlement {
  id       String @id @default(uuid())
  positionId String @unique
  marketId   String
  outcomeId  String
  userId     String
  quantity       Decimal  @db.Decimal(36, 18)
  payoutPerShare Decimal  @db.Decimal(18, 6)
  payoutAmount   Decimal  @db.Decimal(36, 18)
  // Null when payoutAmount is zero (a losing position, or a winning
  // position that happened to hold zero quantity) — nothing was posted
  // to the ledger because no cash moved. Not a hard FK: this is a soft
  // reference for convenience, mirroring how LedgerTransaction itself
  // points OUTWARD at its cause (referenceType/referenceId) rather than
  // the cause holding a hard FK back into the ledger.
  ledgerTransactionId String?
  idempotencyKey      String   @unique
  settledAt           DateTime @default(now())

  position Position      @relation(fields: [positionId], references: [id])
  market   Market        @relation(fields: [marketId], references: [id])
  outcome  MarketOutcome @relation(fields: [outcomeId], references: [id])
  user     User          @relation(fields: [userId], references: [id])

  @@index([marketId])
  @@index([userId])
  @@map("position_settlements")
}

// ────────────────────────────────────────────────────────────────────────
// Ledger — true double-entry accounting.
//
// LedgerTransaction is the journal entry: it carries the business meaning
// (type + reference) and an idempotency key that is the single source of
// truth for "has this financial event already been posted" — every
// crediting/debiting path (deposit crediting, withdrawal capture, trade,
// fee, settlement, adjustment, reversal) creates exactly one, and a repeat
// attempt (retry, duplicate webhook, double-click) hits the unique
// constraint on idempotencyKey and is a safe no-op, never a second credit.
//
// LedgerEntry is a posting within a transaction — one row per account
// touched. A transaction's postings must sum to zero for its asset, so
// every credit has a matching debit; there is always a counterparty
// (a user account, or a HOUSE account such as EXTERNAL_CHAIN standing in
// for the outside blockchain, or FEE_REVENUE). This is enforced in
// LedgerService before any row is written, not just by convention.
//
// FundReservation is a *same-account* earmark (available vs reserved
// funds) — reserving funds for an order or a pending withdrawal does not
// move money between accounts, so it is not itself a LedgerTransaction;
// it only adjusts LedgerAccount.reservedBalance, guarded by its own
// idempotency key and status transitions (ACTIVE -> RELEASED|CAPTURED).
// ────────────────────────────────────────────────────────────────────────

model LedgerAccount {
  id              String                 @id @default(uuid())
  ownerType       LedgerAccountOwnerType @default(USER)
  userId          String?
  houseAccountKey HouseAccountKey?
  assetId         String
  cachedBalance   Decimal                @default(0) @db.Decimal(36, 18)
  reservedBalance Decimal                @default(0) @db.Decimal(36, 18)
  updatedAt       DateTime               @updatedAt

  user         User?             @relation(fields: [userId], references: [id])
  asset        Asset             @relation(fields: [assetId], references: [id])
  entries      LedgerEntry[]
  reservations FundReservation[]

  @@unique([userId, assetId])
  @@unique([houseAccountKey, assetId])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String                @id @default(uuid())
  assetId        String
  type           LedgerTransactionType
  referenceType  String
  referenceId    String
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())

  asset   Asset         @relation(fields: [assetId], references: [id])
  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String
  accountId     String
  amount        Decimal  @db.Decimal(36, 18)
  balanceAfter  Decimal  @db.Decimal(36, 18)
  createdAt     DateTime @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model FundReservation {
  id             String            @id @default(uuid())
  accountId      String
  amount         Decimal           @db.Decimal(36, 18)
  // Portion of `amount` already applied against a real execution (a BUY
  // fill, at the fill's execution price — which may be better than the
  // order's limit price, so this can be less than the naive
  // quantity*limitPrice share). release()/capture() must net against this,
  // never against the full original `amount`. 0 <= consumedAmount <=
  // amount, enforced by a DB CHECK.
  consumedAmount Decimal           @default(0) @db.Decimal(36, 18)
  status         ReservationStatus @default(ACTIVE)
  referenceType  String
  referenceId    String
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  releasedAt     DateTime?
  capturedAt     DateTime?

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, status])
  @@index([referenceType, referenceId])
  @@map("fund_reservations")
}

// ────────────────────────────────────────────────────────────────────────
// Asset / Network model
// ────────────────────────────────────────────────────────────────────────

model Asset {
  id                   String     @id @default(uuid())
  symbol               String     @unique
  name                 String
  decimals             Int
  assetClass           AssetClass
  isSettlementCurrency Boolean    @default(false)
  isActive             Boolean    @default(true)

  assetNetworks             AssetNetwork[]
  ledgerAccounts            LedgerAccount[]
  ledgerTransactions        LedgerTransaction[]
  depositAddressAssignments DepositAddressAssignment[]
  deposits                  Deposit[]

  @@map("assets")
}

model Network {
  id          String             @id @default(uuid())
  code        String             @unique
  family      NetworkFamily
  environment NetworkEnvironment
  name        String
  isActive    Boolean            @default(true)

  assetNetworks             AssetNetwork[]
  depositAddressAssignments DepositAddressAssignment[]

  @@map("networks")
}

model AssetNetwork {
  id                  String   @id @default(uuid())
  assetId             String
  networkId           String
  isNative            Boolean  @default(false)
  contractAddress     String?
  memoRequired        Boolean  @default(false)
  minConfirmations    Int      @default(1)
  depositMinAmount    Decimal  @default(0) @db.Decimal(36, 18)
  withdrawalMinAmount Decimal  @default(0) @db.Decimal(36, 18)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  asset   Asset   @relation(fields: [assetId], references: [id])
  network Network @relation(fields: [networkId], references: [id])

  walletAddresses    WalletAddress[]
  deposits           Deposit[]
  withdrawals        Withdrawal[]
  executionConfig    WithdrawalExecutionConfig?
  watchCursor        BlockchainWatchCursor?
  reconciliationRuns ReconciliationRun[]

  @@unique([assetId, networkId])
  @@map("asset_networks")
}

// ────────────────────────────────────────────────────────────────────────
// Wallet addresses & deposit-address assignment (one dedicated address
// per user + asset + network — pre-provisioned pool, no per-tx generation)
// ────────────────────────────────────────────────────────────────────────

model WalletAddress {
  id             String              @id @default(uuid())
  assetNetworkId String
  address        String
  destinationTag String?
  role           WalletAddressRole   @default(DEPOSIT_POOL)
  environment    NetworkEnvironment
  status         WalletAddressStatus @default(AVAILABLE)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  assetNetwork        AssetNetwork              @relation(fields: [assetNetworkId], references: [id])
  assignment          DepositAddressAssignment?
  deposits            Deposit[]
  withdrawalsAsSource Withdrawal[]

  @@unique([assetNetworkId, address])
  @@index([assetNetworkId, role, status])
  @@map("wallet_addresses")
}

model DepositAddressAssignment {
  id              String                  @id @default(uuid())
  userId          String
  assetId         String
  networkId       String
  assetNetworkId  String
  walletAddressId String                  @unique
  destinationTag  String?
  environment     NetworkEnvironment
  status          AddressAssignmentStatus @default(ACTIVE)
  assignedAt      DateTime                @default(now())
  metadata        Json?

  user          User          @relation(fields: [userId], references: [id])
  asset         Asset         @relation(fields: [assetId], references: [id])
  network       Network       @relation(fields: [networkId], references: [id])
  walletAddress WalletAddress @relation(fields: [walletAddressId], references: [id])

  @@unique([userId, assetId, networkId])
  @@map("deposit_address_assignments")
}

// ────────────────────────────────────────────────────────────────────────
// Deposits & Withdrawals
// ────────────────────────────────────────────────────────────────────────

model Deposit {
  id                    String        @id @default(uuid())
  userId                String
  assetId               String
  assetNetworkId        String
  walletAddressId       String
  txHash                String
  // Disambiguates multiple deposit events within one transaction (e.g. an
  // EVM token transfer's log index, or a batched transaction crediting
  // several recipients) — txHash alone is not a strong enough identity for
  // token transfers. Chains where a transaction maps to exactly one event
  // (native BTC/XRP transfers) just use the default 0. Combined with
  // txHash + assetNetworkId, this is the canonical deposit-event identity.
  eventIndex            Int           @default(0)
  amount                Decimal       @db.Decimal(36, 18)
  confirmations         Int           @default(0)
  requiredConfirmations Int
  status                DepositStatus @default(PENDING)
  rawProviderPayload    Json?
  detectedAt            DateTime      @default(now())
  confirmedAt           DateTime?
  creditedAt            DateTime?

  user          User          @relation(fields: [userId], references: [id])
  asset         Asset         @relation(fields: [assetId], references: [id])
  assetNetwork  AssetNetwork  @relation(fields: [assetNetworkId], references: [id])
  walletAddress WalletAddress @relation(fields: [walletAddressId], references: [id])

  @@unique([assetNetworkId, txHash, eventIndex])
  @@index([userId, status])
  @@map("deposits")
}

model Withdrawal {
  id                    String           @id @default(uuid())
  userId                String
  assetNetworkId        String
  sourceWalletAddressId String?
  destinationAddress    String
  destinationTag        String?
  amount                Decimal          @db.Decimal(36, 18)
  fee                   Decimal          @default(0) @db.Decimal(36, 18)
  status                WithdrawalStatus @default(REQUESTED)
  txHash                String?
  broadcastByAdminId    String?
  broadcastAt           DateTime?
  confirmedAt           DateTime?
  failureReason         String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user                User           @relation(fields: [userId], references: [id])
  assetNetwork        AssetNetwork   @relation(fields: [assetNetworkId], references: [id])
  sourceWalletAddress WalletAddress? @relation(fields: [sourceWalletAddressId], references: [id])

  @@index([userId, status])
  @@index([assetNetworkId, status])
  @@map("withdrawals")
}

model WithdrawalExecutionConfig {
  id             String                 @id @default(uuid())
  assetNetworkId String                 @unique
  environment    NetworkEnvironment
  executorType   WithdrawalExecutorType @default(MANUAL_BROADCAST)
  providerRef    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id])

  @@map("withdrawal_execution_configs")
}

// ────────────────────────────────────────────────────────────────────────
// Monitoring / reconciliation
// ────────────────────────────────────────────────────────────────────────

model BlockchainWatchCursor {
  id                 String   @id @default(uuid())
  assetNetworkId     String   @unique
  lastScannedPointer String
  updatedAt          DateTime @updatedAt

  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id])

  @@map("blockchain_watch_cursors")
}

model ReconciliationRun {
  id             String               @id @default(uuid())
  assetNetworkId String
  runAt          DateTime             @default(now())
  status         ReconciliationStatus
  discrepancies  Json?
  notes          String?

  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id])

  @@index([assetNetworkId, runAt])
  @@map("reconciliation_runs")
}

// ────────────────────────────────────────────────────────────────────────
// Risk & Audit
// ────────────────────────────────────────────────────────────────────────

model RiskLimit {
  id                 String   @id @default(uuid())
  userId             String   @unique
  maxPositionSize    Decimal? @db.Decimal(36, 18)
  maxDailyWithdrawal Decimal? @db.Decimal(36, 18)
  // Per-order extension points. Null (the default) means unlimited —
  // no arbitrary production limit is invented without configuration.
  maxOrderQuantity   Decimal? @db.Decimal(36, 18)
  maxOrderNotional   Decimal? @db.Decimal(36, 18)
  kycTier            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("risk_limits")
}

model AuditLog {
  id             String         @id @default(uuid())
  actorId        String?
  actorType      AuditActorType
  action         String
  resourceType   String
  resourceId     String?
  before         Json?
  after          Json?
  reason         String?
  idempotencyKey String?
  ip             String?
  createdAt      DateTime       @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([idempotencyKey])
  @@map("audit_logs")
}
