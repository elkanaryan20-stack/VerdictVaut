generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  RISK_OPS
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

// DRAFT -> OPEN -> CLOSED -> RESOLVING -> RESOLVED, with CANCELLED reachable
// from any pre-RESOLVED state and PAUSED a reversible halt from OPEN back to
// OPEN. Trading is allowed only in OPEN (enforced in OrdersService, not by a
// CHECK constraint, since that decision needs application context).
enum MarketStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  RESOLVING
  RESOLVED
  CANCELLED
}

enum OrderSide {
  BUY
  SELL
}

// MARKET exists as a value for forward compatibility but is rejected at the
// service layer for now — see OrdersService. A resting "market order" with
// no matching engine to execute it immediately is an incoherent state, not
// a safe simplification.
enum OrderType {
  LIMIT
  MARKET
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  EXPIRED
  REJECTED
}

enum LedgerTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  FEE
  SETTLEMENT
  ADJUSTMENT
  REVERSAL
  // Phase 12A: locks real collateral for a newly-minted complete set — see
  // CompleteSetMint and ExecutionCoordinator.applyMintExecution, the sole
  // writer. Purpose: fund a market's own MARKET-owned LedgerAccount with
  // exactly 1 unit of settlement currency per share minted, so a later
  // SETTLEMENT payout is never unbacked. Debit: both buyers' USER
  // accounts (their own priceA/priceB share of the $1). Credit: the
  // market's MARKET-owned collateral account, +1 per unit quantity.
  // Idempotency key: `mint:${completeSetMint.id}`. Lifecycle: posted
  // exactly once per CompleteSetMint row, in the same transaction that
  // creates it; never reversed by any code path today (a future
  // redeem/burn-before-resolution mechanism, if built, would be the one
  // legitimate reversal path — deliberately out of scope this phase).
  MINT
}

enum LedgerAccountOwnerType {
  USER
  HOUSE
  // Phase 12A: a market's own locked collateral, real cash already
  // debited from users at complete-set mint time — never a house
  // account, never fabricated. One row per (marketId, assetId), never
  // negative (see ledger_accounts_user_balance_check, which already
  // exempts only HOUSE). See CompleteSetMint / SettlementService.
  MARKET
}

// House/omnibus counterparties. EXTERNAL_CHAIN is the mirror of the outside
// blockchain world — it is credited/debited opposite every deposit and
// withdrawal so those transactions balance, and it is explicitly exempt
// from the non-negative-balance rule (see the DB CHECK constraint): its
// balance is a running net-inflow figure, not real platform funds.
enum HouseAccountKey {
  EXTERNAL_CHAIN
  FEE_REVENUE
  // HISTORICAL / NO LONGER USED FOR NEW SETTLEMENTS as of Phase 12A.
  // Originally the counterparty for every market-resolution payout, back
  // when this system had no complete-set/collateral-minting mechanism
  // for outcome shares (a BUY's reserved cash was simply transferred to
  // the matched SELL's own cash balance at execution, with nothing ever
  // escrowed against future settlement) — this account funded payouts
  // directly and was expected to run persistently negative, exactly like
  // EXTERNAL_CHAIN. Phase 12A replaced this with real collateralization:
  // SettlementService now debits the resolving market's own MARKET-owned
  // LedgerAccount (funded at complete-set mint time — see
  // CompleteSetMint, LedgerAccountOwnerType.MARKET), which is provably
  // sufficient to cover every winning payout because minting always
  // locks exactly 1 unit of settlement currency per share created. This
  // enum value is retained, unused by any current code path, purely so
  // historical LedgerAccount/LedgerEntry rows from before Phase 12A
  // remain queryable — never repurposed or hidden under a different
  // name. A future cleanup migration could remove it once no such
  // historical data needs to be read.
  SETTLEMENT_POOL
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CAPTURED
}

enum AssetClass {
  NATIVE
  TOKEN
}

enum NetworkFamily {
  BITCOIN
  EVM
  SOLANA
  XRPL
}

enum NetworkEnvironment {
  SANDBOX
  PRODUCTION
}

enum WalletAddressRole {
  DEPOSIT_POOL
  HOT_WITHDRAWAL
  COLD_RESERVE
  FEE_PAYER
}

enum WalletAddressStatus {
  AVAILABLE
  ASSIGNED
  INACTIVE
  RETIRED
}

enum AddressAssignmentStatus {
  ACTIVE
  REVOKED
}

// PENDING covers both "just detected" and "accumulating confirmations"
// (DETECTED/CONFIRMING in the conceptual state-machine sense) — the
// Deposit row's `confirmations` counter already tracks progress within
// that single status, so a separate CONFIRMING state would carry no
// information PENDING + confirmations doesn't. CONFIRMED means the
// configured ConfirmationPolicy considers the transaction final and it is
// eligible for crediting; CREDITED means the ledger posting has happened
// (terminal, see DepositsService.creditDeposit). REJECTED is terminal and
// distinct from FAILED: it means the chain itself invalidated the
// transaction before credit (e.g. a reorg dropped it, or it never
// resolves to a valid transfer) — an economic "this never happened",
// never entered after CREDITED. FAILED is terminal for a
// processing-side problem (adapter/validation error, tag mismatch) that
// may be worth investigating/retrying via the admin reprocess path.
enum DepositStatus {
  PENDING
  CONFIRMED
  CREDITED
  REJECTED
  FAILED
}

// REQUESTED never persists as an externally-observable state — it is
// created and immediately advanced to RISK_REVIEW within the SAME
// SERIALIZABLE transaction as its FundReservation (see
// WithdrawalsService.request()), so there is never an observable moment
// where a withdrawal row exists without its reservation already in
// place. This is a stronger guarantee than an explicit separate
// "RESERVED" state would give, so none is added.
// CANCELLED is the user-initiated counterpart to REJECTED (admin-
// initiated) — reachable only before SUPER_ADMIN review begins.
enum WithdrawalStatus {
  REQUESTED
  VALIDATED
  RISK_REVIEW
  APPROVED
  PENDING_MANUAL_BROADCAST
  BROADCASTING
  BROADCAST
  CONFIRMING
  CONFIRMED
  CREDITED
  REJECTED
  FAILED
  CANCELLED
  // Phase 14A — WithdrawalExecutor.execute() returned "ambiguous": the
  // call to the (future) custody provider itself failed in a way that
  // leaves it genuinely unknown whether the provider actually executed
  // the withdrawal (e.g. a network timeout after the request left this
  // process). Reverting to APPROVED for a blind retry would risk a real
  // double-execution if the provider DID act; the reservation stays
  // held (see RESERVATION_STILL_HELD_STATUSES) until a SUPER_ADMIN
  // explicitly resolves it via resolveAmbiguousExecution() — by
  // checking the provider directly (WithdrawalExecutor.checkStatus(),
  // where implemented) or via out-of-band confirmation.
  EXECUTION_AMBIGUOUS
}

enum WithdrawalExecutorType {
  MANUAL_BROADCAST
  PRODUCTION_CUSTODY
}

// Phase 14A — the two provider categories WithdrawalComplianceGate's
// real implementation would call: KYC covers who the user is
// (identity verification, ongoing sanctions/PEP screening at the
// person level); SANCTIONS_KYT covers what a specific withdrawal
// touches (destination-address risk scoring, crypto transaction
// monitoring). See ComplianceProviderConfig.
enum ComplianceProviderCategory {
  KYC
  SANCTIONS_KYT
}

// Phase 9: the explicit, honest result of WithdrawalComplianceGate.assess()
// at request time — never silently treated as "approved". DEFERRED means
// no real KYC/AML/sanctions system is wired up yet (the current default,
// see DeferredComplianceGate) — the withdrawal still proceeds to human
// SUPER_ADMIN review, which remains the one real gate today. BLOCKED
// stops the request outright with the gate's own reason.
enum WithdrawalComplianceDecision {
  PASS
  BLOCKED
  DEFERRED
}

enum ReconciliationStatus {
  OK
  DISCREPANCY_FOUND
  ERROR
}

// Phase 12A: distinguishes the original cursor-adjacent checks
// (ReconciliationService.run — address-balance vs. internal-ledger
// consistency, stale-cursor detection) from the new independent rescan
// (IndependentReconciliationService — re-derives chain observations
// fresh, deliberately never trusting BlockchainWatchCursor).
enum ReconciliationRunType {
  CURSOR_BASED_CHECKS
  INDEPENDENT_RESCAN
  // Phase 13: a market-scoped check (CollateralReconciliationService)
  // verifying a market's own MARKET LedgerAccount balance equals total
  // CompleteSetMint quantity minus total PositionSettlement payouts —
  // never chain/assetNetwork-scoped, see ReconciliationRun.marketId.
  COLLATERAL_CHECK
}

// SUPER_ADMIN-controlled resolution lifecycle for one
// ReconciliationDiscrepancy row — see that model's own docblock.
enum DiscrepancyStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

// PENDING never actually persists today — Settlement rows are created
// already-COMPLETED at resolution time (the payout RATE for an outcome is
// decided and fixed the instant the market resolves; nothing further
// "processes" about it afterward). Kept as a real state, not collapsed to
// a boolean, so a future multi-step rate-approval workflow has somewhere
// to live without a schema change.
enum SettlementStatus {
  PENDING
  COMPLETED
}

// ────────────────────────────────────────────────────────────────────────
// Identity
// ────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(PENDING_VERIFICATION)
  totpSecret   String?
  // Phase 18 remediation — the real (email-ownership) verification
  // mechanism that moves a user PENDING_VERIFICATION -> ACTIVE. Only
  // the SHA-256 hash of the raw token is ever stored (same pattern as
  // RefreshToken.tokenHash) — the raw value exists only transiently in
  // memory and in the response returned at registration time (see
  // AuthService.register's own docblock on environment-gating that).
  // Single-use: AuthService.verifyEmail clears both columns on success,
  // so a captured/replayed token can never be consumed twice.
  // emailVerifiedAt is set ONLY by genuine self-service verification —
  // an admin-driven activation (UsersService.adminActivate) deliberately
  // leaves it null, so "was this email actually proven, or did an admin
  // override it" stays a real, auditable distinction rather than being
  // collapsed into one ambiguous timestamp.
  emailVerificationTokenHash      String?
  emailVerificationTokenExpiresAt DateTime?
  emailVerifiedAt                 DateTime?
  // Phase 13 remediation — bounded, auto-expiring login throttle (see
  // login-throttle.util.ts). Never a permanent lockout requiring manual
  // admin unlock: lockedUntil always expires on its own, and a
  // successful login resets both fields immediately. Deliberately only
  // ever set on a REAL user row — an attacker submitting wrong passwords
  // for a nonexistent email has no row to throttle, which is what keeps
  // this from being usable as a resource-exhaustion vector.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens             RefreshToken[]
  orders                    Order[]
  positions                 Position[]
  ledgerAccounts            LedgerAccount[]
  depositAddressAssignments DepositAddressAssignment[]
  deposits                  Deposit[]
  withdrawals               Withdrawal[]
  riskLimit                 RiskLimit?
  createdMarkets            Market[]                   @relation("MarketCreatedBy")
  fillsAsBuyer              Fill[]                     @relation("FillBuyer")
  fillsAsSeller             Fill[]                     @relation("FillSeller")
  marketResolutions         MarketResolution[]
  positionSettlements       PositionSettlement[]
  mintsAsBuyerA             CompleteSetMint[]          @relation("MintBuyerA")
  mintsAsBuyerB             CompleteSetMint[]          @relation("MintBuyerB")
  initiatedReconciliationRuns   ReconciliationRun[]
  resolvedDiscrepancies         ReconciliationDiscrepancy[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ────────────────────────────────────────────────────────────────────────
// Markets & Trading
// ────────────────────────────────────────────────────────────────────────

model MarketCategory {
  id   String @id @default(uuid())
  slug String @unique
  name String

  markets Market[]

  @@map("market_categories")
}

model Market {
  id                 String       @id @default(uuid())
  slug               String       @unique
  title              String
  description        String
  categoryId         String
  status             MarketStatus @default(DRAFT)
  resolutionSource   String?
  // What resolves the market, as distinct from resolutionSource (where to
  // check) — the rule a resolver applies, e.g. "Resolves YES if the Fed
  // cuts rates at the March 2027 FOMC meeting per the official statement."
  resolutionCriteria String?
  openTime           DateTime?
  closeTime          DateTime?
  resolutionTime     DateTime?
  // Optional per-market cap on aggregate open BUY exposure (sum of
  // remainingQuantity * price across resting BUY orders) for one outcome.
  // Null means no cap is configured — never a silently-invented default.
  maxExposure        Decimal?     @db.Decimal(36, 18)
  createdById        String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  category    MarketCategory  @relation(fields: [categoryId], references: [id])
  createdBy   User            @relation("MarketCreatedBy", fields: [createdById], references: [id])
  outcomes    MarketOutcome[]
  orders      Order[]
  settlements Settlement[]
  resolution  MarketResolution?
  positionSettlements PositionSettlement[]
  // Phase 12A: this market's own collateral LedgerAccount(s) — in
  // practice exactly one, for the platform's single settlement-currency
  // asset (see ledger_accounts_marketId_assetId_key).
  ledgerAccounts      LedgerAccount[]
  completeSetMints    CompleteSetMint[]
  // Phase 13: this market's own collateral-integrity check history —
  // see CollateralReconciliationService.
  reconciliationRuns          ReconciliationRun[]
  reconciliationDiscrepancies ReconciliationDiscrepancy[]

  @@index([categoryId])
  @@index([status])
  @@map("markets")
}

model MarketOutcome {
  id        String   @id @default(uuid())
  marketId  String
  // Stable, machine-referenced identifier (e.g. "YES"/"NO") — distinct from
  // `label`, the human-readable display text, so relabeling a market never
  // touches the identity outcomes are ordered/traded by. Binary markets use
  // YES/NO today; the model does not assume only two outcomes ever exist.
  key       String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  market      Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  orders      Order[]
  positions   Position[]
  settlements Settlement[]
  resolutionWins      MarketResolution[]
  positionSettlements PositionSettlement[]
  mintsAsOutcomeA     CompleteSetMint[] @relation("MintOutcomeA")
  mintsAsOutcomeB     CompleteSetMint[] @relation("MintOutcomeB")

  @@unique([marketId, key])
  @@map("market_outcomes")
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  marketId          String
  outcomeId         String
  side              OrderSide
  type              OrderType
  price             Decimal?    @db.Decimal(18, 6)
  quantity          Decimal     @db.Decimal(36, 18)
  filledQuantity    Decimal     @default(0) @db.Decimal(36, 18)
  // The live field the (future) matcher decrements; filledQuantity is the
  // complementary historical figure. filledQuantity + remainingQuantity =
  // quantity is enforced by a DB CHECK constraint, not just convention.
  remainingQuantity Decimal     @db.Decimal(36, 18)
  status            OrderStatus @default(OPEN)
  // Client-supplied (or server-generated when omitted) idempotency key.
  // Always populated — see OrdersService — so the unique index below is
  // never defeated by NULLs not colliding under Postgres's default
  // unique-index semantics.
  clientOrderId     String
  // Monotonic, gap-tolerant, server-assigned tie-breaker for price-time
  // priority. createdAt is a millisecond timestamp — two orders placed in
  // the same millisecond (routine under concurrent submission) would be
  // ordered ambiguously by it, and the id (a UUID) is intentionally
  // non-sequential and must never be used as an ordering signal. sequence
  // is a DB-generated bigserial: strictly increasing, assigned atomically
  // at insert time, safe as the deterministic same-price FIFO tie-breaker
  // the matching engine relies on.
  sequence          BigInt      @unique @default(autoincrement())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  market    Market        @relation(fields: [marketId], references: [id])
  outcome   MarketOutcome @relation(fields: [outcomeId], references: [id])
  buyFills  Fill[]        @relation("BuyOrder")
  sellFills Fill[]        @relation("SellOrder")
  makerFills Fill[]       @relation("MakerOrder")
  takerFills Fill[]       @relation("TakerOrder")
  mintsAsA  CompleteSetMint[] @relation("MintBuyOrderA")
  mintsAsB  CompleteSetMint[] @relation("MintBuyOrderB")

  @@unique([userId, clientOrderId])
  // Primary order-book / price-time-priority lookup path: resting
  // candidates for a given market+outcome+side+status, ordered by price
  // then by the deterministic sequence tie-breaker.
  @@index([marketId, outcomeId, side, status, price, sequence])
  @@index([marketId, outcomeId, status])
  @@index([userId])
  @@map("orders")
}

model Fill {
  id             String   @id @default(uuid())
  marketId       String
  outcomeId      String
  buyOrderId     String
  sellOrderId    String
  // MAKER = the resting order that was already on the book (its price is
  // always the execution price). TAKER = the incoming order that crossed
  // it. Always one of makerOrderId/takerOrderId equals buyOrderId and the
  // other equals sellOrderId — enforced by fills_maker_taker_check — but
  // buy/sell (economic direction) and maker/taker (who was resting vs.
  // incoming) are independent axes and both are kept explicit rather than
  // derived, since either one could be the maker.
  makerOrderId   String
  takerOrderId   String
  buyerUserId    String
  sellerUserId   String
  price          Decimal  @db.Decimal(18, 6)
  quantity       Decimal  @db.Decimal(36, 18)
  fee            Decimal  @default(0) @db.Decimal(36, 18)
  // Deterministic, derived from the (makerOrderId, takerOrderId) execution
  // identity by the matching/execution layer — guards against the same
  // match being applied twice (retry, concurrent re-derivation of the same
  // instruction), the same primitive used for LedgerTransaction/
  // FundReservation in the ledger. Fills are append-only: no service
  // method updates an existing Fill row.
  idempotencyKey String   @unique
  executedAt     DateTime @default(now())

  buyOrder  Order @relation("BuyOrder", fields: [buyOrderId], references: [id])
  sellOrder Order @relation("SellOrder", fields: [sellOrderId], references: [id])
  makerOrder Order @relation("MakerOrder", fields: [makerOrderId], references: [id])
  takerOrder Order @relation("TakerOrder", fields: [takerOrderId], references: [id])
  buyer     User  @relation("FillBuyer", fields: [buyerUserId], references: [id])
  seller    User  @relation("FillSeller", fields: [sellerUserId], references: [id])

  @@index([marketId, outcomeId])
  @@index([buyOrderId])
  @@index([sellOrderId])
  @@index([makerOrderId])
  @@index([takerOrderId])
  @@map("fills")
}

model Position {
  id               String   @id @default(uuid())
  userId           String
  marketId         String
  outcomeId        String
  quantity         Decimal  @default(0) @db.Decimal(36, 18)
  // Earmarked by an ACTIVE PositionReservation (SELL orders) — the
  // outcome-share mirror of LedgerAccount.reservedBalance. Available shares
  // = quantity - reservedQuantity, enforced by DB CHECK, same invariant
  // shape as the cash ledger's.
  reservedQuantity Decimal  @default(0) @db.Decimal(36, 18)
  avgPrice         Decimal  @default(0) @db.Decimal(18, 6)
  // Ordinary trade P&L, realized the instant shares change hands (see
  // ExecutionCoordinator.updatePositions) — entirely independent of, and
  // NOT the same figure as, a market-resolution settlement payout (see
  // PositionSettlement.payoutAmount). Never conflate the two.
  realizedPnl      Decimal  @default(0) @db.Decimal(36, 18)
  // Null = not yet settled. Set exactly once, atomically with the
  // creation of this position's PositionSettlement row (which is the
  // actual idempotent guarantee — see that model). A frozen historical
  // marker: nothing updates quantity/avgPrice/realizedPnl after this is
  // set, since no further trading can occur once a market leaves OPEN.
  settledAt        DateTime?
  updatedAt        DateTime @updatedAt

  user         User                  @relation(fields: [userId], references: [id])
  outcome      MarketOutcome         @relation(fields: [outcomeId], references: [id])
  reservations PositionReservation[]
  settlement   PositionSettlement?

  @@unique([userId, marketId, outcomeId])
  // Enumerating a market's still-unsettled positions (SettlementService)
  // is an indexed range scan, not a full-table scan.
  @@index([marketId, settledAt])
  @@map("positions")
}

// Outcome-share reservation — the position-quantity counterpart to
// FundReservation (cash). Deliberately mirrors its shape (ACTIVE ->
// RELEASED|CAPTURED, its own idempotency key) rather than reusing
// FundReservation directly, because FundReservation is hard-FK'd to
// LedgerAccount (a real-asset account) and shares are not a LedgerAccount
// asset — conflating the two would be the "accounting shortcut" this
// architecture is explicitly trying to avoid.
model PositionReservation {
  id             String            @id @default(uuid())
  positionId     String
  amount         Decimal           @db.Decimal(36, 18)
  // Portion of `amount` already applied against a real execution (a SELL
  // fill). A partial fill consumes only the executed quantity, leaving the
  // remainder ACTIVE and earmarked for the rest of the order — release()
  // and capture() must net against this, never against the full original
  // `amount`, or a partially-consumed reservation would be double-counted
  // on release. 0 <= consumedAmount <= amount, enforced by a DB CHECK.
  consumedAmount Decimal           @default(0) @db.Decimal(36, 18)
  status         ReservationStatus @default(ACTIVE)
  referenceType  String
  referenceId    String
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  releasedAt     DateTime?
  capturedAt     DateTime?

  position Position @relation(fields: [positionId], references: [id])

  @@index([positionId, status])
  @@index([referenceType, referenceId])
  @@map("position_reservations")
}

// The resolved payout RATE for one outcome of one market — exactly one
// row per (market, outcome), created for EVERY outcome (not just the
// winner) atomically with MarketResolution, in the same transaction as
// the CLOSED -> RESOLVING status transition. This is the rate; it says
// nothing about any individual user's position — that is
// PositionSettlement's job, one level down.
model Settlement {
  id             String           @id @default(uuid())
  marketId       String
  outcomeId      String
  payoutPerShare Decimal          @db.Decimal(18, 6)
  status         SettlementStatus @default(PENDING)
  processedAt    DateTime?
  createdAt      DateTime         @default(now())

  market  Market        @relation(fields: [marketId], references: [id])
  outcome MarketOutcome @relation(fields: [outcomeId], references: [id])

  @@unique([marketId, outcomeId])
  @@map("settlements")
}

// The single authoritative, auditable record of what a market resolved
// to — created exactly once per market (marketId is unique, the actual
// DB-level "never resolve twice" guarantee, alongside the CLOSED ->
// RESOLVING CAS in ResolutionService) atomically with that transition.
// resolvedAt is when the outcome was DECIDED; settledAt is a distinct,
// later event — set only once every position in this market has been
// paid out and the market reaches RESOLVED (see SettlementService). A
// market can sit with resolvedAt set and settledAt still null for a
// while if settlement is large/retried; that is an expected, valid,
// in-progress state (status = RESOLVING), not a bug.
model MarketResolution {
  id               String    @id @default(uuid())
  marketId         String    @unique
  winningOutcomeId String
  resolverId       String
  // Optional human-readable rationale (e.g. a citation of the resolution
  // source). Free text, not JSON — there is nothing structured to gain
  // from encoding a rationale as a document.
  notes            String?
  resolvedAt       DateTime  @default(now())
  settledAt        DateTime?

  market         Market        @relation(fields: [marketId], references: [id])
  winningOutcome MarketOutcome @relation(fields: [winningOutcomeId], references: [id])
  resolver       User          @relation(fields: [resolverId], references: [id])

  @@map("market_resolutions")
}

// Append-only, idempotent, per-position payout record — the settlement
// counterpart to Fill. Its existence (idempotencyKey unique, positionId
// unique) IS the authoritative "this position has been settled"
// guarantee: it is created in the SAME transaction as the ledger posting
// (when payoutAmount > 0) and the owning Position's settledAt stamp, so
// this row existing implies both already happened too — never partially.
// quantity/payoutPerShare are immutable snapshots taken at settlement
// time, independent of Position's own (by then frozen) figures.
model PositionSettlement {
  id       String @id @default(uuid())
  positionId String @unique
  marketId   String
  outcomeId  String
  userId     String
  quantity       Decimal  @db.Decimal(36, 18)
  payoutPerShare Decimal  @db.Decimal(18, 6)
  payoutAmount   Decimal  @db.Decimal(36, 18)
  // Null when payoutAmount is zero (a losing position, or a winning
  // position that happened to hold zero quantity) — nothing was posted
  // to the ledger because no cash moved. Not a hard FK: this is a soft
  // reference for convenience, mirroring how LedgerTransaction itself
  // points OUTWARD at its cause (referenceType/referenceId) rather than
  // the cause holding a hard FK back into the ledger.
  ledgerTransactionId String?
  idempotencyKey      String   @unique
  settledAt           DateTime @default(now())

  position Position      @relation(fields: [positionId], references: [id])
  market   Market        @relation(fields: [marketId], references: [id])
  outcome  MarketOutcome @relation(fields: [outcomeId], references: [id])
  user     User          @relation(fields: [userId], references: [id])

  @@index([marketId])
  @@index([userId])
  @@map("position_settlements")
}

// Phase 12A: the ONLY mechanism that ever increases the total float of an
// outcome's shares (see ExecutionCoordinator.applyMintExecution, the sole
// writer) — every other position change is a transfer between existing
// holders (see ExecutionCoordinator.updatePositions), never a creation.
// A complete-set mint is one BUY order on outcome A crossing a
// complementary resting BUY order on outcome B, where priceA + priceB =
// 1 exactly (complete_set_mints_price_sum_check) — the whole reason
// settlement stays fully collateralized: `quantity` new shares of EACH
// outcome are created, and exactly `quantity` units of settlement
// currency are simultaneously locked in the market's own MARKET-owned
// LedgerAccount (see the paired LedgerTransactionType.MINT posting).
// Restricted to exactly-binary (2-outcome) markets — see
// CompleteSetMintEngine's own docblock for why a 3+-outcome market's
// SELL orders still require pre-existing inventory, unchanged.
model CompleteSetMint {
  id            String   @id @default(uuid())
  marketId      String
  outcomeAId    String
  outcomeBId    String
  buyOrderAId   String
  buyOrderBId   String
  buyerAUserId  String
  buyerBUserId  String
  priceA        Decimal  @db.Decimal(18, 6)
  priceB        Decimal  @db.Decimal(18, 6)
  quantity      Decimal  @db.Decimal(36, 18)
  // Deterministic, derived from the (makerOrderId, takerOrderId)
  // identity pair by CompleteSetMintEngine — the same idempotency
  // primitive Fill.idempotencyKey uses, guarding against the same mint
  // being applied twice (retry, concurrent re-derivation).
  idempotencyKey String  @unique
  mintedAt      DateTime @default(now())

  market    Market        @relation(fields: [marketId], references: [id])
  outcomeA  MarketOutcome @relation("MintOutcomeA", fields: [outcomeAId], references: [id])
  outcomeB  MarketOutcome @relation("MintOutcomeB", fields: [outcomeBId], references: [id])
  buyOrderA Order         @relation("MintBuyOrderA", fields: [buyOrderAId], references: [id])
  buyOrderB Order         @relation("MintBuyOrderB", fields: [buyOrderBId], references: [id])
  buyerA    User          @relation("MintBuyerA", fields: [buyerAUserId], references: [id])
  buyerB    User          @relation("MintBuyerB", fields: [buyerBUserId], references: [id])

  @@index([marketId])
  @@index([buyOrderAId])
  @@index([buyOrderBId])
  @@map("complete_set_mints")
}

// ────────────────────────────────────────────────────────────────────────
// Ledger — true double-entry accounting.
//
// LedgerTransaction is the journal entry: it carries the business meaning
// (type + reference) and an idempotency key that is the single source of
// truth for "has this financial event already been posted" — every
// crediting/debiting path (deposit crediting, withdrawal capture, trade,
// fee, settlement, adjustment, reversal) creates exactly one, and a repeat
// attempt (retry, duplicate webhook, double-click) hits the unique
// constraint on idempotencyKey and is a safe no-op, never a second credit.
//
// LedgerEntry is a posting within a transaction — one row per account
// touched. A transaction's postings must sum to zero for its asset, so
// every credit has a matching debit; there is always a counterparty
// (a user account, or a HOUSE account such as EXTERNAL_CHAIN standing in
// for the outside blockchain, or FEE_REVENUE). This is enforced in
// LedgerService before any row is written, not just by convention.
//
// FundReservation is a *same-account* earmark (available vs reserved
// funds) — reserving funds for an order or a pending withdrawal does not
// move money between accounts, so it is not itself a LedgerTransaction;
// it only adjusts LedgerAccount.reservedBalance, guarded by its own
// idempotency key and status transitions (ACTIVE -> RELEASED|CAPTURED).
// ────────────────────────────────────────────────────────────────────────

model LedgerAccount {
  id              String                 @id @default(uuid())
  ownerType       LedgerAccountOwnerType @default(USER)
  userId          String?
  houseAccountKey HouseAccountKey?
  // Phase 12A: populated iff ownerType = MARKET — see
  // ledger_accounts_owner_ref_check for the DB-level guarantee that
  // exactly one of userId/houseAccountKey/marketId is set, matching
  // ownerType. Never a house account: this is real collateral, locked
  // from real user cash at complete-set mint time (see CompleteSetMint).
  marketId        String?
  assetId         String
  cachedBalance   Decimal                @default(0) @db.Decimal(36, 18)
  reservedBalance Decimal                @default(0) @db.Decimal(36, 18)
  updatedAt       DateTime               @updatedAt

  user         User?             @relation(fields: [userId], references: [id])
  market       Market?           @relation(fields: [marketId], references: [id])
  asset        Asset             @relation(fields: [assetId], references: [id])
  entries      LedgerEntry[]
  reservations FundReservation[]

  @@unique([userId, assetId])
  @@unique([houseAccountKey, assetId])
  @@unique([marketId, assetId])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String                @id @default(uuid())
  assetId        String
  type           LedgerTransactionType
  referenceType  String
  referenceId    String
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())

  asset   Asset         @relation(fields: [assetId], references: [id])
  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String   @id @default(uuid())
  transactionId String
  accountId     String
  amount        Decimal  @db.Decimal(36, 18)
  balanceAfter  Decimal  @db.Decimal(36, 18)
  createdAt     DateTime @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model FundReservation {
  id             String            @id @default(uuid())
  accountId      String
  amount         Decimal           @db.Decimal(36, 18)
  // Portion of `amount` already applied against a real execution (a BUY
  // fill, at the fill's execution price — which may be better than the
  // order's limit price, so this can be less than the naive
  // quantity*limitPrice share). release()/capture() must net against this,
  // never against the full original `amount`. 0 <= consumedAmount <=
  // amount, enforced by a DB CHECK.
  consumedAmount Decimal           @default(0) @db.Decimal(36, 18)
  status         ReservationStatus @default(ACTIVE)
  referenceType  String
  referenceId    String
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  releasedAt     DateTime?
  capturedAt     DateTime?

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, status])
  @@index([referenceType, referenceId])
  @@map("fund_reservations")
}

// ────────────────────────────────────────────────────────────────────────
// Asset / Network model
// ────────────────────────────────────────────────────────────────────────

model Asset {
  id                   String     @id @default(uuid())
  symbol               String     @unique
  name                 String
  decimals             Int
  assetClass           AssetClass
  isSettlementCurrency Boolean    @default(false)
  isActive             Boolean    @default(true)

  assetNetworks             AssetNetwork[]
  ledgerAccounts            LedgerAccount[]
  ledgerTransactions        LedgerTransaction[]
  depositAddressAssignments DepositAddressAssignment[]
  deposits                  Deposit[]

  @@map("assets")
}

model Network {
  id          String             @id @default(uuid())
  code        String             @unique
  family      NetworkFamily
  environment NetworkEnvironment
  name        String
  isActive    Boolean            @default(true)

  assetNetworks             AssetNetwork[]
  depositAddressAssignments DepositAddressAssignment[]

  @@map("networks")
}

// Phase 14A — asset_networks_active_token_requires_contract_check
// (added in the collateral/login-throttle-era migration set) enforces,
// at the DATABASE level, that an active non-native AssetNetwork always
// has a contractAddress — the application-level check in
// AssetsNetworksService (Phase 11) already refused this at create/
// activate time, but that check only guards its own code path; the DB
// constraint holds even against a direct write (e.g. a seed script)
// that bypasses the service entirely. See prisma/seed.ts's USDT/
// ethereum-sepolia row for exactly the case this exists to catch: no
// real Sepolia USDT contract exists, so that row is seeded isActive:
// false, honestly non-functional, rather than inventing an address.
model AssetNetwork {
  id                  String   @id @default(uuid())
  assetId             String
  networkId           String
  isNative            Boolean  @default(false)
  contractAddress     String?
  memoRequired        Boolean  @default(false)
  minConfirmations    Int      @default(1)
  depositMinAmount    Decimal  @default(0) @db.Decimal(36, 18)
  withdrawalMinAmount Decimal  @default(0) @db.Decimal(36, 18)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  asset   Asset   @relation(fields: [assetId], references: [id])
  network Network @relation(fields: [networkId], references: [id])

  walletAddresses    WalletAddress[]
  deposits           Deposit[]
  withdrawals        Withdrawal[]
  executionConfig    WithdrawalExecutionConfig?
  watchCursor        BlockchainWatchCursor?
  reconciliationRuns ReconciliationRun[]
  discrepancies      ReconciliationDiscrepancy[]

  @@unique([assetId, networkId])
  @@map("asset_networks")
}

// ────────────────────────────────────────────────────────────────────────
// Wallet addresses & deposit-address assignment (one dedicated address
// per user + asset + network — pre-provisioned pool, no per-tx generation)
// ────────────────────────────────────────────────────────────────────────

model WalletAddress {
  id             String              @id @default(uuid())
  assetNetworkId String
  address        String
  destinationTag String?
  role           WalletAddressRole   @default(DEPOSIT_POOL)
  environment    NetworkEnvironment
  status         WalletAddressStatus @default(AVAILABLE)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  assetNetwork        AssetNetwork              @relation(fields: [assetNetworkId], references: [id])
  assignment          DepositAddressAssignment?
  deposits            Deposit[]
  withdrawalsAsSource Withdrawal[]

  @@unique([assetNetworkId, address])
  @@index([assetNetworkId, role, status])
  @@map("wallet_addresses")
}

model DepositAddressAssignment {
  id              String                  @id @default(uuid())
  userId          String
  assetId         String
  networkId       String
  assetNetworkId  String
  walletAddressId String                  @unique
  destinationTag  String?
  environment     NetworkEnvironment
  status          AddressAssignmentStatus @default(ACTIVE)
  assignedAt      DateTime                @default(now())
  metadata        Json?

  user          User          @relation(fields: [userId], references: [id])
  asset         Asset         @relation(fields: [assetId], references: [id])
  network       Network       @relation(fields: [networkId], references: [id])
  walletAddress WalletAddress @relation(fields: [walletAddressId], references: [id])

  @@unique([userId, assetId, networkId])
  @@map("deposit_address_assignments")
}

// ────────────────────────────────────────────────────────────────────────
// Deposits & Withdrawals
// ────────────────────────────────────────────────────────────────────────

model Deposit {
  id                    String        @id @default(uuid())
  userId                String
  assetId               String
  assetNetworkId        String
  walletAddressId       String
  txHash                String
  // Disambiguates multiple deposit events within one transaction (e.g. an
  // EVM token transfer's log index, or a batched transaction crediting
  // several recipients) — txHash alone is not a strong enough identity for
  // token transfers. Chains where a transaction maps to exactly one event
  // (native BTC/XRP transfers) just use the default 0. Combined with
  // txHash + assetNetworkId, this is the canonical deposit-event identity.
  eventIndex            Int           @default(0)
  amount                Decimal       @db.Decimal(36, 18)
  confirmations         Int           @default(0)
  requiredConfirmations Int
  status                DepositStatus @default(PENDING)
  // Observed on-chain destination tag/memo (XRP and similar tag-addressed
  // chains) — captured whenever the adapter reports one, regardless of
  // whether this asset/network requires it, so it is never silently
  // discarded. Compared against the receiving WalletAddress's configured
  // tag before crediting when AssetNetwork.memoRequired is true; see
  // DepositsService.
  destinationTag        String?
  // Set only when this deposit could not be safely processed (a tag
  // mismatch, an adapter/validation error) — human-readable, never a
  // secret. Distinct from a REJECTED status's chain-level invalidation:
  // this can accompany FAILED, or a still-PENDING/CONFIRMED row awaiting
  // admin reprocessing.
  failureReason         String?
  // Number of admin-triggered reprocessing attempts against this deposit
  // -- operational visibility only, never itself a trigger for crediting.
  retryCount            Int           @default(0)
  // Soft reference to the LedgerTransaction this deposit's credit posted,
  // set atomically with creditedAt/CREDITED (mirrors
  // PositionSettlement.ledgerTransactionId) -- lets reconciliation join
  // deposit and ledger history without trusting cached balances.
  ledgerTransactionId   String?
  rawProviderPayload    Json?
  detectedAt            DateTime      @default(now())
  // Last time a watcher or admin reprocess actually re-checked this
  // deposit's on-chain state -- lets stalled/never-progressing deposits
  // be found with a simple query instead of scanning rawProviderPayload.
  lastCheckedAt         DateTime?
  confirmedAt           DateTime?
  creditedAt            DateTime?

  user          User          @relation(fields: [userId], references: [id])
  asset         Asset         @relation(fields: [assetId], references: [id])
  assetNetwork  AssetNetwork  @relation(fields: [assetNetworkId], references: [id])
  walletAddress WalletAddress @relation(fields: [walletAddressId], references: [id])

  @@unique([assetNetworkId, txHash, eventIndex])
  @@index([userId, status])
  @@index([status, lastCheckedAt])
  @@map("deposits")
}

model Withdrawal {
  id                    String           @id @default(uuid())
  userId                String
  assetNetworkId        String
  sourceWalletAddressId String?
  destinationAddress    String
  destinationTag        String?
  amount                Decimal          @db.Decimal(36, 18)
  // Platform fee, deducted from `amount` (never added on top of the
  // user's reservation) — see ZeroWithdrawalFeeCalculator's docblock for
  // why this stays 0 today and how the accounting works once it doesn't.
  fee                   Decimal          @default(0) @db.Decimal(36, 18)
  status                WithdrawalStatus @default(REQUESTED)
  // Client-supplied (or server-generated when omitted) idempotency key —
  // the withdrawal counterpart to Order.clientOrderId. Always populated,
  // so the unique index below is never defeated by NULLs not colliding
  // under Postgres's default unique-index semantics.
  clientWithdrawalId    String
  txHash                String?
  // Provider-side reference for this execution attempt (e.g. a custody
  // provider's own request/transfer id), DISTINCT from txHash — a real
  // ProductionCustodyExecutor may receive one before any on-chain
  // transaction hash exists. Never a secret; safe to expose to the
  // owning user and to SUPER_ADMIN.
  custodyReference      String?
  broadcastByAdminId    String?
  broadcastAt           DateTime?
  confirmedAt           DateTime?
  failureReason         String?
  // WithdrawalComplianceGate.assess()'s result at request time — see
  // that interface's docblock. Never silently implied to be "passed";
  // DEFERRED is recorded and surfaced honestly, not hidden.
  complianceDecision    WithdrawalComplianceDecision?
  complianceNote        String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user                User           @relation(fields: [userId], references: [id])
  assetNetwork        AssetNetwork   @relation(fields: [assetNetworkId], references: [id])
  sourceWalletAddress WalletAddress? @relation(fields: [sourceWalletAddressId], references: [id])

  @@unique([userId, clientWithdrawalId])
  @@index([userId, status])
  @@index([assetNetworkId, status])
  @@map("withdrawals")
}

model WithdrawalExecutionConfig {
  id             String                 @id @default(uuid())
  assetNetworkId String                 @unique
  environment    NetworkEnvironment
  executorType   WithdrawalExecutorType @default(MANUAL_BROADCAST)
  // Free-text, asset-network-specific note (e.g. "vault-3") — distinct
  // from custodyProviderConfigId below, which is the shared, provider-
  // LEVEL configuration this asset/network's executions run through.
  providerRef    String?
  // Phase 14A — required when executorType = PRODUCTION_CUSTODY (see
  // withdrawal_execution_configs_custody_requires_provider_check): one
  // CustodyProviderConfig can back many asset/networks (a single
  // Fireblocks/BitGo account handling several chains), so this is a
  // many-to-one link, not a duplicate of the provider config itself.
  custodyProviderConfigId String?
  // Phase 14B — the PROVIDER's own identifier for this asset (e.g.
  // whatever Fireblocks' real asset-id string is for this chain/token).
  // Deliberately NEVER defaulted/inferred from assetSymbol: the Phase
  // 14B research verified Fireblocks' request/response field NAMES but
  // could NOT verify the literal asset-id strings (not even a documented
  // "XRP" string) from accessible primary sources. Left null until a
  // human who actually has sandbox/production account access confirms
  // the real value via the provider's own "list supported assets"
  // capability — see FireblocksCustodyAdapter.supportsAssetNetwork(),
  // which returns false (fail closed) while this is null, regardless of
  // whether everything else is configured.
  providerAssetId String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  assetNetwork          AssetNetwork           @relation(fields: [assetNetworkId], references: [id])
  custodyProviderConfig CustodyProviderConfig? @relation(fields: [custodyProviderConfigId], references: [id])

  @@map("withdrawal_execution_configs")
}

// Phase 14A — provider-LEVEL custody configuration: one row per real
// custody account/integration (e.g. one Fireblocks production account),
// referenced by however many WithdrawalExecutionConfig rows need it.
// Deliberately provider-NEUTRAL: providerName is free-text/display data
// only, never branched on by application code (that would mean a real
// integration exists, which it doesn't yet — see
// ProductionCustodyExecutor). credentialsSecretRef/webhookSecretRef are
// REFERENCES to where a real secret lives (e.g. "env:FIREBLOCKS_API_KEY"
// or "secretsmanager:prod/fireblocks/api-key") — never the secret
// itself; see custody_provider_configs_secret_ref_scheme_check and
// CustodyProviderConfigService's own validation for why a raw-looking
// value is rejected outright, not just discouraged.
model CustodyProviderConfig {
  id                    String             @id @default(uuid())
  providerName          String
  environment           NetworkEnvironment
  isEnabled             Boolean            @default(false)
  credentialsSecretRef  String?
  webhookUrl            String?
  webhookSecretRef      String?
  timeoutMs             Int                @default(10000)
  // Documents the provider's OWN idempotency mechanism (e.g.
  // "Idempotency-Key" for Fireblocks) — purely descriptive until a real
  // executor implementation exists to read it; never invented if
  // unknown, left null instead.
  idempotencyHeaderName String?
  // Non-secret account/vault identifier (e.g. a Fireblocks vault id) —
  // an identifier, not a credential, so no scheme:path format is required.
  vaultOrAccountRef     String?
  // Phase 14B — non-secret REST base URL (e.g.
  // "https://sandbox-api.fireblocks.io/v1", verified against Fireblocks'
  // own docs). Admin-configurable rather than hardcoded so environment
  // confusion (sandbox vs. production URL) is a visible config value,
  // not a compiled-in constant — see FireblocksCustodyAdapter.
  apiBaseUrl            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  executionConfigs WithdrawalExecutionConfig[]

  @@index([environment, isEnabled])
  @@map("custody_provider_configs")
}

// Phase 14A — provider-neutral compliance configuration, one row per
// real KYC or crypto-AML/sanctions (KYT) integration. Same
// reference-not-secret discipline as CustodyProviderConfig. Enabling a
// row here does NOT itself make WithdrawalComplianceGate real — that
// still requires an actual implementation replacing DeferredComplianceGate
// (see that class's own docblock); this table exists so
// ProductionSafetyGate can verify configuration completeness
// independently of whether the code-level swap has also happened.
model ComplianceProviderConfig {
  id                   String                     @id @default(uuid())
  category             ComplianceProviderCategory
  providerName         String
  environment          NetworkEnvironment
  isEnabled            Boolean                    @default(false)
  credentialsSecretRef String?
  webhookUrl           String?
  webhookSecretRef     String?
  timeoutMs            Int                        @default(10000)
  // Phase 14B — non-secret REST base URL (e.g.
  // "https://aml-api.elliptic.co/v2", verified against Elliptic's own
  // docs). See CustodyProviderConfig.apiBaseUrl for the same reasoning.
  apiBaseUrl           String?
  // Phase 14B — a raw provider risk score (e.g. Elliptic's numeric
  // `risk_score`, which is NOT a VerdictVaut-defined categorical value)
  // is mapped to AddressRiskStatus via these admin-configured
  // thresholds: score >= riskScoreHighThreshold => HIGH,
  // score >= riskScoreMediumThreshold => MEDIUM, else LOW. Nullable and
  // unused by providers (like a pure KYC provider) that never report a
  // numeric score at all.
  riskScoreMediumThreshold Float?
  riskScoreHighThreshold   Float?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([category, environment, isEnabled])
  @@map("compliance_provider_configs")
}

// Phase 14B — durable, idempotent record of every inbound provider
// webhook event, independent of whatever mutation (if any) processing
// it triggered. `externalEventId` is the PROVIDER's own event/delivery
// id (e.g. Fireblocks' webhook payload doesn't publish a single
// canonical event id distinct from the transaction id + status +
// lastUpdated tuple per the Phase 14B verification pass — so
// `externalEventId` is deliberately DERIVED deterministically from
// provider + the transaction id + status + lastUpdated, not invented,
// giving the same real duplicate-delivery and out-of-order protection
// a true event id would). The unique constraint is what makes
// re-processing the identical delivery a safe no-op — this table is
// the ONLY thing a webhook handler ever writes directly; every actual
// state transition still goes through WithdrawalsService.
model ProviderWebhookEvent {
  id               String    @id @default(uuid())
  provider         String
  externalEventId  String
  eventType        String
  resourceType     String?
  resourceId       String?
  payload          Json
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  processingNote   String?
  processingError  String?

  @@unique([provider, externalEventId])
  @@index([resourceType, resourceId])
  @@map("provider_webhook_events")
}

// ────────────────────────────────────────────────────────────────────────
// Monitoring / reconciliation
// ────────────────────────────────────────────────────────────────────────

model BlockchainWatchCursor {
  id                 String    @id @default(uuid())
  assetNetworkId     String    @unique
  lastScannedPointer String
  // Worker-concurrency lease (Phase 10) -- a CAS-acquired, time-bounded
  // lock so multiple concurrently-running watcher instances never scan
  // (and duplicate RPC work / race to advance) the same asset/network at
  // once. lockedBy is an opaque per-process worker id, never a secret. A
  // lease older than the configured staleness window is treated as
  // abandoned (a crashed worker) and may be reacquired by another
  // worker -- see DepositWatcherService.
  lockedAt           DateTime?
  lockedBy           String?
  // Distinct from `updatedAt` (which changes on every write, including a
  // lease acquire/release with no actual progress) -- set only when a
  // scan pass actually completed without error, so admin operational
  // visibility (requirement #15) can tell "healthy, just nothing new"
  // apart from "has been failing" via lastError/lastErrorAt below.
  lastSuccessAt      DateTime?
  lastError          String?
  lastErrorAt        DateTime?
  updatedAt          DateTime  @updatedAt

  assetNetwork AssetNetwork @relation(fields: [assetNetworkId], references: [id])

  @@map("blockchain_watch_cursors")
}

model ReconciliationRun {
  id             String               @id @default(uuid())
  // Phase 13: exactly one of assetNetworkId/marketId is set — chain
  // rescans are asset-network-scoped, collateral checks are
  // market-scoped. Mirrors ledger_accounts_owner_ref_check's "exactly
  // one of X/Y" pattern. See reconciliation_runs_target_check.
  assetNetworkId String?
  marketId       String?
  runAt          DateTime             @default(now())
  status         ReconciliationStatus
  // Embedded-JSON findings — the original, pre-Phase-12A shape, still
  // used by ReconciliationService.run's cursor-adjacent checks. The new
  // IndependentReconciliationService instead writes first-class
  // ReconciliationDiscrepancy rows (discrepancyRecords below), which
  // carry a real SUPER_ADMIN resolution lifecycle these JSON blobs never
  // had — kept separate rather than migrating the old checks onto the
  // new model, to avoid an unrelated, riskier refactor of a working
  // system in the same phase that introduces the new capability.
  discrepancies  Json?
  notes          String?
  runType           ReconciliationRunType @default(CURSOR_BASED_CHECKS)
  // Who triggered this run — always populated for INDEPENDENT_RESCAN
  // (SUPER_ADMIN-only, see admin.controller.ts); nullable because
  // pre-Phase-12A CURSOR_BASED_CHECKS rows never recorded this.
  initiatedByUserId String?
  // The independently-derived rescan window actually used — e.g. an EVM
  // block range. Null for CURSOR_BASED_CHECKS (that path re-derives its
  // own window internally per check and was never asked to report it).
  fromPointer       String?
  toPointer         String?

  assetNetwork       AssetNetwork?               @relation(fields: [assetNetworkId], references: [id])
  market             Market?                     @relation(fields: [marketId], references: [id])
  initiatedBy        User?                       @relation(fields: [initiatedByUserId], references: [id])
  discrepancyRecords ReconciliationDiscrepancy[]

  @@index([assetNetworkId, runAt])
  @@index([marketId, runAt])
  @@map("reconciliation_runs")
}

// First-class, individually-resolvable discrepancy record — the
// independent rescan's counterpart to the old checks' embedded-JSON
// findings (see ReconciliationRun.discrepancies). `idempotencyKey` is
// deterministic (assetNetworkId + type + the chain identity that proves
// it), so re-running an independent rescan that re-observes the SAME
// still-open real-world discrepancy never creates a duplicate row —
// only a genuinely new instance of a given (type, chainIdentity) pair
// after the prior one was resolved creates a new one.
//
// This table is an OBSERVATION/CONTROL record only — nothing in this
// codebase ever reads a row here and automatically credits/debits a
// user, releases/completes a withdrawal, or reverses a deposit. Every
// resolution is a deliberate SUPER_ADMIN action (see
// IndependentReconciliationService.acknowledge/resolve).
model ReconciliationDiscrepancy {
  id             String            @id @default(uuid())
  runId          String
  // Phase 13: exactly one of assetNetworkId/marketId is set — see
  // ReconciliationRun's own note and reconciliation_discrepancies_target_check.
  assetNetworkId String?
  marketId       String?
  // Stable, machine-matchable slug — e.g.
  // "chain_event_missing_internal_deposit". Never a vague free-text blob.
  type           String
  severity       String
  // The independent evidence key that proves this discrepancy's
  // identity — e.g. a txHash, or "txHash:eventIndex" for a chain whose
  // transactions can carry multiple events (see Deposit.eventIndex).
  chainIdentity      String
  internalEntityType String?
  internalEntityId   String?
  expectedState      Json
  observedState      Json
  status         DiscrepancyStatus @default(OPEN)
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?
  resolvedByUserId String?
  notes          String?
  idempotencyKey String            @unique

  run          ReconciliationRun @relation(fields: [runId], references: [id])
  assetNetwork AssetNetwork?     @relation(fields: [assetNetworkId], references: [id])
  market       Market?           @relation(fields: [marketId], references: [id])
  resolvedBy   User?             @relation(fields: [resolvedByUserId], references: [id])

  @@index([assetNetworkId, status])
  @@index([marketId, status])
  @@index([runId])
  @@map("reconciliation_discrepancies")
}

// ────────────────────────────────────────────────────────────────────────
// Risk & Audit
// ────────────────────────────────────────────────────────────────────────

model RiskLimit {
  id                 String   @id @default(uuid())
  userId             String   @unique
  maxPositionSize    Decimal? @db.Decimal(36, 18)
  maxDailyWithdrawal Decimal? @db.Decimal(36, 18)
  // Per-order extension points. Null (the default) means unlimited —
  // no arbitrary production limit is invented without configuration.
  maxOrderQuantity   Decimal? @db.Decimal(36, 18)
  maxOrderNotional   Decimal? @db.Decimal(36, 18)
  kycTier            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("risk_limits")
}

model AuditLog {
  id             String         @id @default(uuid())
  actorId        String?
  actorType      AuditActorType
  action         String
  resourceType   String
  resourceId     String?
  before         Json?
  after          Json?
  reason         String?
  idempotencyKey String?
  ip             String?
  createdAt      DateTime       @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
  @@index([idempotencyKey])
  @@map("audit_logs")
}
