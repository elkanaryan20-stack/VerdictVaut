# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# sandbox = testnet/manual-broadcast custody behavior, production = live custody (not yet implemented)
APP_ENVIRONMENT=sandbox

# ── Database ─────────────────────────────────────────────────────────────
# Matches infra/docker-compose.yml defaults if you use it as-is.
DATABASE_URL="postgresql://verdictvaut:verdictvaut@localhost:5432/verdictvaut?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=changeme-access-secret-min-32-chars
JWT_REFRESH_SECRET=changeme-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS ─────────────────────────────────────────────────────────────────
# Only used when NODE_ENV != development — comma-separated list of allowed
# origins. Empty (the default) means no cross-origin requests are allowed.
CORS_ALLOWED_ORIGINS=

# ── Dev-only tooling ─────────────────────────────────────────────────────
# Master switch for any developer-only convenience endpoints (e.g. sandbox
# funding helpers). MUST be false/unset in production; enforced in code as
# well as by this flag, never relied on alone.
ENABLE_DEV_FUNDING_TOOLS=false

# ── Blockchain RPC / provider endpoints (sandbox/testnet) ─────────────────
# Optional — each falls back to a public sandbox endpoint (see
# chain-adapters/rpc-config.service.ts) when unset. Set these to point at
# a credentialed provider (Infura/Alchemy/QuickNode/etc.) instead of the
# public default. These are read-only RPC/explorer credentials — never a
# signing key.
BITCOIN_TESTNET_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
SOLANA_DEVNET_RPC_URL=
XRPL_TESTNET_RPC_URL=

# ── Deposit chain watcher ──────────────────────────────────────────────────
# Off by default — no automated app instance (including every test run)
# makes outbound network calls to a chain provider unless this is
# explicitly set to true. Admin-triggered single-deposit reprocessing
# (POST /admin/deposits/:id/reprocess) and reconciliation runs still work
# regardless of this flag, since they're on-demand, not the poll loop.
CHAIN_WATCHER_ENABLED=false
CHAIN_WATCHER_POLL_INTERVAL_MS=30000

# ── Withdrawal watcher ───────────────────────────────────────────────────
# Same off-by-default reasoning as CHAIN_WATCHER_ENABLED above — polls
# BROADCAST/CONFIRMING withdrawals for on-chain confirmations AND
# PENDING_MANUAL_BROADCAST withdrawals for a real provider's own
# checkStatus() (e.g. Fireblocks) once one is configured (see
# WithdrawalWatcherService, WithdrawalExecutorFactory).
WITHDRAWAL_WATCHER_ENABLED=false
WITHDRAWAL_WATCHER_POLL_INTERVAL_MS=30000

# ── Deployment boundary (Phase 16) ────────────────────────────────────────
# The HTTP API process (main.ts) refuses to boot at all if either watcher
# flag above is true, unless this is explicitly set — background watchers
# belong in the dedicated worker process (worker.main.ts). See
# docs/deployment-architecture.md. Leave false for a two-process
# (API + worker) deployment; set true only for a deliberate single-process
# deployment.
ALLOW_WATCHERS_IN_API_PROCESS=false

# ── Background worker process (worker.main.ts, Phase 16) ─────────────────
# The worker binds no HTTP port, so its container liveness is judged by a
# heartbeat file instead (see scripts/worker-healthcheck.js and the worker
# Docker target's HEALTHCHECK). Irrelevant to the API process.
WORKER_HEARTBEAT_FILE=/tmp/verdictvaut-worker-heartbeat
WORKER_HEARTBEAT_INTERVAL_MS=15000

# ── Custody / compliance provider credentials (Phase 14B) ─────────────────
# IMPORTANT — this app does NOT read fixed-name env vars for provider
# credentials directly. CustodyProviderConfig.credentialsSecretRef and
# ComplianceProviderConfig.credentialsSecretRef/webhookSecretRef instead
# hold a "scheme:path" REFERENCE (see secret-ref.validator.ts) — e.g.
# "env:FIREBLOCKS_SANDBOX_CREDENTIALS" — that SecretResolverService
# resolves at call time (only the "env:" scheme is implemented; it reads
# process.env[path]). An admin (SUPER_ADMIN, via the provider-config
# admin API — see docs/provider-integration.md §10) chooses BOTH the
# env var name AND stores the "env:<name>" reference in the database;
# nothing in application code hardcodes these specific names.
#
# The names below are this project's established CONVENTION (used
# consistently in docs/provider-integration.md and
# docs/fireblocks-sandbox-smoke-test.md) — not a requirement enforced by
# code. Set them locally/in your secret manager ONLY if you are actually
# running a real Fireblocks/Elliptic SANDBOX smoke test; leave unset
# otherwise. NEVER put a real value in this checked-in .env.example file
# — only in your own untracked .env / secret manager.
#
# FIREBLOCKS_SANDBOX_CREDENTIALS must be a JSON string:
#   {"apiKey": "...", "privateKey": "-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----"}
# (see FireblocksCustodyAdapter.resolveHttpConfig — a malformed/missing
# value fails closed with a clear error, never a guessed default.)
FIREBLOCKS_SANDBOX_CREDENTIALS=<set-in-secret-manager-or-local-env>

# FIREBLOCKS_WEBHOOK_PUBLIC_KEY holds Fireblocks' own published webhook
# verification PUBLIC key (PEM). Technically not secret, but stored via
# the same "env:" reference mechanism as everything else (see
# fireblocks-webhook-verifier.util.ts / CustodyProviderConfig.webhookSecretRef).
FIREBLOCKS_WEBHOOK_PUBLIC_KEY=<set-in-secret-manager-or-local-env>

# ELLIPTIC_SANDBOX_CREDENTIALS must be a JSON string:
#   {"apiKey": "...", "apiSecret": "<base64-encoded HMAC secret>"}
# (see EllipticAddressRiskGate.resolveHttpConfig.) Elliptic is a
# compliance/address-risk provider, not custody — configuring this does
# NOT enable any real-money movement.
ELLIPTIC_SANDBOX_CREDENTIALS=<set-in-secret-manager-or-local-env>
